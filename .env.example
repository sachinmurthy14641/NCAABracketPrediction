# ---------------------------------------------------------------
# Kalshi API credentials
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
# ---------------------------------------------------------------

# Your Kalshi API key ID (from Settings → API in the Kalshi dashboard)
KALSHI_API_KEY_ID=your-api-key-id-here

# Absolute path to your RSA private key PEM file
KALSHI_PRIVATE_KEY_PATH=/path/to/your/private-key.pem

# Trading environment: "demo" (default) or "production"
KALSHI_ENV=demo

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
